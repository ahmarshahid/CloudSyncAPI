# Copy this file to ".env" and fill in your values. ".env" is git-ignored.

# --- Django secret key (signs sessions and JWT tokens; keep it private) ---
# Generate one with:
#   .venv/bin/python -c "import secrets; print(secrets.token_urlsafe(50))"
SECRET_KEY=

# --- Gmail SMTP (real emails) ---
# Leave SMTP_USER / SMTP_PASSWORD empty to print emails in the runserver console instead.
SMTP_USER=your-address@gmail.com
# Gmail App Password (Google Account > Security > 2-Step Verification > App passwords).
# Not your normal Gmail password.
SMTP_PASSWORD=
# Optional overrides
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USE_TLS=True
# If your network blocks port 587, use SSL on port 465 instead:
# SMTP_PORT=465
# SMTP_USE_SSL=True
# SMTP_USE_TLS=False
# DEFAULT_FROM_EMAIL=your-address@gmail.com

# --- Login link base URL ---
# Must be reachable by whoever clicks the link. Use your tunnel/domain URL for other devices.
SITE_URL=http://XXX.X.X.X:0000
# Add the tunnel/domain host here when it's not localhost, e.g. localhost,127.0.0.1,abc.ngrok-free.app
# ALLOWED_HOSTS=localhost,127.0.0.1

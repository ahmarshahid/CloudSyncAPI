# Copy this file to ".env" and fill in your values. ".env" is git-ignored.

# --- Django secret key (signs sessions and JWT tokens; keep it private) ---
# Generate one with:
#   .venv/bin/python -c "import secrets; print(secrets.token_urlsafe(50))"
SECRET_KEY=

# --- Email Configuration ---
# OPTION A: MailHog for local development (http://localhost:8025)
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
SMTP_USE_SSL=False
SMTP_USE_TLS=False
DEFAULT_FROM_EMAIL=no-reply@cloudsync.local

# OPTION B: Gmail SMTP (production/staging)
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=your-address@gmail.com
# SMTP_PASSWORD=your-app-password
# SMTP_USE_TLS=True
# SMTP_USE_SSL=False

# --- Login link base URL ---
# Must be reachable by whoever clicks the link. Use your tunnel/domain URL for other devices.
SITE_URL=http://XXX.X.X.X:0000
# Add the tunnel/domain host here when it's not localhost, e.g. localhost,127.0.0.1,abc.ngrok-free.app
# ALLOWED_HOSTS=localhost,127.0.0.1

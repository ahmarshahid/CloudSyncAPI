# ─────────────────────────────────────────────────────────────────────────────
# LOCAL DEVELOPMENT — copy this file to ".env" and fill in your values.
# For Docker, copy to ".env.docker" instead (see docker-compose.yml).
# Both ".env" and ".env.docker" are git-ignored.
# ─────────────────────────────────────────────────────────────────────────────

# ── Django ────────────────────────────────────────────────────────────────────
# Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(50))"
SECRET_KEY=

DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# ── Database (optional — defaults to BASE_DIR/db.sqlite3) ────────────────────
# Override in Docker to store the DB inside a named volume:
# DB_PATH=/app/data/db.sqlite3

# ── Email Configuration ───────────────────────────────────────────────────────
# OPTION A: MailHog for local development (http://localhost:8025)
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
SMTP_USE_SSL=False
SMTP_USE_TLS=False
DEFAULT_FROM_EMAIL=no-reply@cloudsync.local

# OPTION B: Gmail SMTP (production/staging)
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=your-address@gmail.com
# SMTP_PASSWORD=your-app-password
# SMTP_USE_TLS=True
# SMTP_USE_SSL=False

# ── Login link base URL ───────────────────────────────────────────────────────
# Must be reachable by whoever clicks the link.
SITE_URL=http://localhost:8000

# ── Google Drive OAuth 2.0 ────────────────────────────────────────────────────
# Create a Web application credential at https://console.cloud.google.com/apis/credentials
# with Authorized redirect URI: http://localhost:8000/api/drive/callback/
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/api/drive/callback/

# ── Celery & Redis ────────────────────────────────────────────────────────────
# Local (Redis must be running): redis://localhost:6379/0
# Docker (uses internal service name): redis://redis:6379/0
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0